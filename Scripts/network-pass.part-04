                    continue
                }
                coverURLs.append(url)
            }
            await ArtworkStore.shared.prefetch(
                urls: coverURLs,
                pixelSize: 360
            )
            await lyricsPrefetch
            guard !Task.isCancelled else { return }
            self?.networkPrefetchTask = nil
        }
    }

