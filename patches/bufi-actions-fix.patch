diff --git a/.github/workflows/verify-bufi-pr.yml b/.github/workflows/verify-bufi-pr.yml
--- a/.github/workflows/verify-bufi-pr.yml
+++ b/.github/workflows/verify-bufi-pr.yml
@@
           APP_PID="${LAUNCH_OUTPUT##*: }"
           test -n "$APP_PID"
           sleep 8
-          xcrun simctl spawn "$SIMULATOR_UDID" launchctl procinfo "$APP_PID"
+          PROCINFO="$(xcrun simctl spawn "$SIMULATOR_UDID" launchctl procinfo "$APP_PID" 2>&1 || true)"
+          printf '%s\n' "$PROCINFO"
+          printf '%s\n' "$PROCINFO" | grep -q 'job state = running'
           DATA_CONTAINER="$(xcrun simctl get_app_container "$SIMULATOR_UDID" cloud.tae00217.BuFi data)"
           PREFS="$DATA_CONTAINER/Library/Preferences/cloud.tae00217.BuFi.plist"
           test -f "$PREFS"
           test "$(/usr/libexec/PlistBuddy -c 'Print :launch-diagnostics-last-phase' "$PREFS")" = "application-bootstrap-ready"
